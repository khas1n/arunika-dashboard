    "@maskito/kit": "^5.6.0",
    "@maskito/react": "^5.6.0",
    "@noble/hashes": "^2.4.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@t3-oss/env-core": "^0.13.10",
